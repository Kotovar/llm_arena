# Local machine settings. Copy to .env and replace the placeholder values.
LLM_ARENA_MODEL_DIRECTORY=/absolute/path/to/models
LLM_ARENA_LLAMA_SERVER=/absolute/path/to/llama-server

# Optional: only when OMP is not available through PATH.
# LLM_ARENA_OMP_EXECUTABLE=/absolute/path/to/omp

# Optional: use a complete untracked config file instead of arena.config.yaml.
# LLM_ARENA_CONFIG=/absolute/path/to/arena.config.local.yaml
